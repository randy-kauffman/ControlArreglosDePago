<Project Sdk="Microsoft.NET.Sdk">

  <!-- Mini spike de verificacion de los dobles (2026-10-14). Paquete de plugins SONDA descartable: no hace nada salvo que el InitiatingUserId sea el
       usuario de aplicacion del spike Y la fila sea ZZF-SND-. Se registra, se usa y se BORRA (d90). Mismo patron que spikes/sandbox/src/Spk.Plugins. -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Spk.SondaDobles</RootNamespace>
    <AssemblyName>Spk.SondaDobles</AssemblyName>
    <PowerAppsTargetsPath>$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps</PowerAppsTargetsPath>
    <!-- El ensamblado sube su tercer numero en cada despliegue (alm.md); el paquete conserva su version. -->
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <ProjectTypeGuids>{4C25E9B5-9FA6-436c-8E19-B395D2A65FAF};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
  </PropertyGroup>

  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Plugin.props" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Plugin.props')" />

  <PropertyGroup>
    <PackageId>spk_SondaDobles</PackageId>
    <Version>1.0.0</Version>
    <Authors>spike</Authors>
    <Description>Mini spike de verificacion de los dobles (proyecto 2026-003). Sonda descartable.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" PrivateAssets="All" />
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Plugin" Version="1.*" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.*" PrivateAssets="All" />
  </ItemGroup>

  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Plugin.targets" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Plugin.targets')" />
</Project>
