<Project Sdk="Microsoft.NET.Sdk">
  <!-- Consola DESCARTABLE del mini spike de verificacion de los dobles (2026-10-14). Solo se compila y ejecuta este proyecto; nada de src/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dbl.Medidor</RootNamespace>
    <AssemblyName>Dbl.Medidor</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.26" />
  </ItemGroup>
</Project>
