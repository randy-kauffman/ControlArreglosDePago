<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pruebas xUnit del paquete de plugins (diseno/01-convenciones.md §5). Corren en net8.0 contra el ensamblado net8.0.
       SIN FakeXrmEasy: sus versiones 2.x y 3.x exigen licencia comercial (BP-PP-159). El dominio se prueba con pruebas
       unitarias puras y la capa de datos con un doble propio en memoria (diseno/03 §4.5). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- SDK de Dataverse para .NET moderno (Microsoft.Xrm.Sdk, Microsoft.Crm.Sdk.Proxy). Lo usaran los dobles de 4.5 en los lotes
         de Steps y Datos; el dominio puro (lote 1) no lo necesita. Misma version que el ensamblado. -->
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.26" />
    <ProjectReference Include="../Sanic.Carp.Plugins/Sanic.Carp.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixtures: plantilla v07 y respuestas reales exportadas de Dev (diseno/03 §4.5). Aun no hay ninguno; la carpeta se copia al salir. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
